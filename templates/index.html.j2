<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Jobons — Jobs étudiants Montpellier</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="static/style.css" />
</head>
<body>

  <!-- ═══════════════ HEADER ═══════════════ -->
  <header class="site-header">
    <div class="container">
      <div class="header-inner">
        <div class="brand">
          <span class="brand-logo" aria-hidden="true">◈</span>
          <div>
            <h1 class="brand-name">Jobons</h1>
            <p class="brand-tagline">Jobs étudiants · Montpellier &amp; alentours</p>
          </div>
        </div>
        <div class="header-meta">
          <span class="update-badge">
            <span class="update-dot"></span>
            Mis à jour le {{ last_update }}
          </span>
        </div>
      </div>
    </div>
  </header>

  <!-- ═══════════════ HERO / SEARCH ═══════════════ -->
  <section class="hero">
    <div class="container">
      <p class="hero-count"><strong id="count-display">{{ total }}</strong> offres disponibles</p>
      <div class="search-bar">
        <svg class="search-icon" viewBox="0 0 20 20" fill="none" aria-hidden="true">
          <circle cx="8.5" cy="8.5" r="5.5" stroke="currentColor" stroke-width="1.6"/>
          <path d="M13 13l3.5 3.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
        </svg>
        <input
          id="search-input"
          type="text"
          placeholder="Métier, entreprise, mot-clé…"
          autocomplete="off"
          aria-label="Rechercher une offre"
        />
        <button class="search-clear" id="search-clear" aria-label="Effacer" hidden>✕</button>
      </div>
    </div>
  </section>

  <!-- ═══════════════ FILTERS ═══════════════ -->
  <div class="filters-bar">
    <div class="container">
      <div class="filters-inner">
        <div class="filter-group">
          <label for="filter-contrat" class="filter-label">Contrat</label>
          <select id="filter-contrat" class="filter-select">
            <option value="">Tous</option>
            <option value="CDD">CDD</option>
            <option value="Intérim">Intérim</option>
            <option value="Saisonnier">Saisonnier</option>
            <option value="Alternance">Alternance</option>
          </select>
        </div>

        <div class="filter-group">
          <label for="filter-secteur" class="filter-label">Secteur</label>
          <select id="filter-secteur" class="filter-select">
            <option value="">Tous</option>
          </select>
        </div>

        <div class="filter-group">
          <label for="filter-ville" class="filter-label">Ville</label>
          <select id="filter-ville" class="filter-select">
            <option value="">Toutes</option>
            <option value="Montpellier">Montpellier</option>
            <option value="Lattes">Lattes</option>
            <option value="Pérols">Pérols</option>
          </select>
        </div>

        <div class="filter-group">
          <label for="filter-source" class="filter-label">Source</label>
          <select id="filter-source" class="filter-select">
            <option value="">Toutes</option>
            <option value="france_travail">France Travail</option>
            <option value="adzuna">Adzuna</option>
            <option value="alternance">Alternance (LBA)</option>
          </select>
        </div>

        <button class="filter-reset" id="filter-reset">Réinitialiser</button>
        <button class="filter-refresh" id="filter-refresh">
          <svg viewBox="0 0 16 16" fill="none" aria-hidden="true" class="icon-sm">
            <path d="M13 8A5 5 0 1 1 8 3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
            <path d="M8 1l3 2-3 2" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          Mettre à jour
        </button>
      </div>
    </div>
  </div>

  <!-- ═══════════════ JOBS GRID ═══════════════ -->
  <main class="main-content">
    <div class="container">

      <div id="no-results" class="empty-state" hidden>
        <p class="empty-icon">🔍</p>
        <p class="empty-title">Aucune offre trouvée</p>
        <p class="empty-sub">Essayez d'autres mots-clés ou réinitialisez les filtres.</p>
      </div>

      <div id="jobs-grid" class="jobs-grid">
        {% for offre in offres %}
        <article
          class="job-card"
          data-titre="{{ offre.titre | lower }}"
          data-entreprise="{{ offre.entreprise | lower }}"
          data-description="{{ offre.description | lower }}"
          data-secteur="{{ offre.secteur }}"
          data-contrat="{{ offre.type_contrat_label }}"
          data-lieu="{{ offre.lieu }}"
          data-source="{{ offre.source }}"
        >
          <div class="card-header">
            <div class="card-title-row">
              <h2 class="job-title">{{ offre.titre }}</h2>
              <span class="badge badge-{{ offre.type_contrat | lower }}">{{ offre.type_contrat_label }}</span>
            </div>
            <p class="job-company">
              <svg viewBox="0 0 16 16" fill="none" aria-hidden="true" class="icon-sm">
                <rect x="2" y="7" width="12" height="8" rx="1" stroke="currentColor" stroke-width="1.4"/>
                <path d="M5 7V5a3 3 0 016 0v2" stroke="currentColor" stroke-width="1.4"/>
              </svg>
              {{ offre.entreprise }}
            </p>
          </div>

          <p class="job-description">{{ offre.description[:200] }}{% if offre.description | length > 200 %}…{% endif %}</p>

          <div class="card-footer">
            <div class="job-meta">
              <span class="meta-item">
                <svg viewBox="0 0 16 16" fill="none" aria-hidden="true" class="icon-sm">
                  <circle cx="8" cy="7" r="3" stroke="currentColor" stroke-width="1.4"/>
                  <path d="M8 12c-3 0-5-2-5-5a5 5 0 1110 0c0 3-2 5-5 5z" stroke="currentColor" stroke-width="1.4"/>
                </svg>
                {{ offre.lieu }}
              </span>
              <span class="meta-item">
                <svg viewBox="0 0 16 16" fill="none" aria-hidden="true" class="icon-sm">
                  <circle cx="8" cy="8" r="6" stroke="currentColor" stroke-width="1.4"/>
                  <path d="M8 5v3l2 2" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
                </svg>
                {{ offre.duree_hebdo }}
              </span>
              {% if offre.secteur %}
              <span class="meta-item meta-secteur">{{ offre.secteur }}</span>
              {% endif %}
            </div>

            <div class="card-actions">
              <span class="source-badge source-{{ offre.source }}">{{ offre.source | replace('_', ' ') }}</span>
              <span class="job-date">{{ offre.date_publication }}</span>
              <a href="{{ offre.url }}" target="_blank" rel="noopener noreferrer" class="btn-voir">
                Voir l'offre
                <svg viewBox="0 0 16 16" fill="none" aria-hidden="true" class="icon-sm">
                  <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </a>
            </div>
          </div>
        </article>
        {% endfor %}
      </div>

    </div>
  </main>

  <!-- ═══════════════ FOOTER ═══════════════ -->
  <footer class="site-footer">
    <div class="container">
      <p>
        Données issues de <strong>France Travail</strong>, <strong>Adzuna</strong> et <strong>La Bonne Alternance</strong>.
        Offres filtrées : CDD · Intérim · Saisonnier (max 20h/sem) · Alternance · sans diplôme requis.
      </p>
      <p class="footer-copy">© {{ annee }} Jobons — Projet open-source, aucun lien avec les employeurs listés.</p>
    </div>
  </footer>

  <script src="static/app.js"></script>
</body>
</html>
